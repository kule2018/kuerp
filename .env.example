# ============================================================================
# 全栈编排环境变量（docker compose 自动读取同目录 .env）
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================================

# 对外访问端口（前端）
WEB_PORT=8080

# ---------- 数据库 ----------
DB_NAME=kuerp_erp
DB_PASSWORD=root

# ---------- 鉴权 ----------
# 生产环境务必改成随机长字符串，否则任何人都能伪造 token
JWT_SECRET=kuerp-nestjs-erp-secret-change-me
JWT_EXPIRES_IN=7200

# ---------- AI（OpenAI 兼容接口，可选）----------
# 留空则 AI 功能不可用，不影响进销存主流程
AI_DEFAULT_BASE_URL=https://api.deepseek.com/v1
AI_DEFAULT_API_KEY=
AI_DEFAULT_MODEL=deepseek-chat

# ---------- 进程内缓存 ----------
CACHE_MAX=2000
CACHE_TTL=60
