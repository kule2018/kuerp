# ============ 应用 ============
PORT=3000
# 全局路由前缀（留空表示不添加前缀，业务接口保持 /kuerp/xxx 与原系统一致）
GLOBAL_PREFIX=

# ============ 数据库 (MySQL 5.7+) ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=kuerp_erp
DB_CHARSET=utf8mb4
# 表前缀：原系统表名 kuerp_goods，这里保持 kuerp_ 不用额外前缀
DB_PREFIX=kuerp_
# 启动是否自动同步表结构（首次建议 true，生产可改 false 配合 migration）
DB_SYNCHRONIZE=false

# ============ JWT ============
JWT_SECRET=kuerp-nestjs-erp-secret-change-me
JWT_EXPIRES_IN=7200

# ============ AI（OpenAI 兼容接口，支持 DeepSeek / 通义 / 本地 Ollama 等）============
# 默认模型配置也可在此提供，运行时以数据库 AiModelConfig 中的「启用」记录为准
AI_DEFAULT_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini
AI_DEFAULT_TEMPERATURE=0.7
AI_DEFAULT_MAX_TOKENS=2048

# 是否启用 AI 调用/工具调用落库日志
AI_ENABLE_LOG=true
